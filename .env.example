# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of emails allowed to reach the main homepage.
# Anyone who signs in but isn't listed here is redirected to classroom.google.com.
WHITELISTED_EMAILS=you@gmail.com,friend@gmail.com
